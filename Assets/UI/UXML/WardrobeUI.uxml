<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/CommonStylesheet.uss?fileID=7433441132597879392&amp;guid=8e23400638b471247abded66e2e9521e&amp;type=3#CommonStylesheet"/>
    <Style src="project://database/Assets/UI/USS/WardrobeStylesheet.uss?fileID=7433441132597879392&amp;guid=81c303d3ec7a30445a00a6fbc3330ab1&amp;type=3#WardrobeStylesheet"/>
    <ui:VisualElement name="AppDocumentRoot" class="app-document-root">
        <ui:Image name="imgBackground" class="wardrobe-room-background"/>
        <ui:VisualElement name="topRow" class="topRow">
            <ui:Button text="&lt; Back" name="btnBack" class="button-common"/>
            <ui:VisualElement class="textbox" style="margin-left: 10px;">
                <ui:Label text="1980s Formal" name="scenarioDesc" class="scenario-description" style="padding-right: 25px; padding-left: 25px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="middleRow" style="flex-direction: row; flex-grow: 1; min-height: 0; min-width: 0; padding-right: 25px; padding-left: 25px;">
            <ui:VisualElement name="middleColumn" class="middle-column" style="flex-grow: 2;">
                <ui:Image name="activeAvatar" class="stacked-image"/>
                <ui:Image name="activeShoes" class="stacked-image"/>
                <ui:Image name="activeBottoms" class="stacked-image"/>
                <ui:Image name="activeTop" enabled="true" class="stacked-image"/>
                <ui:Image name="activeJacket" enabled="true" class="stacked-image"/>
            </ui:VisualElement>
            <ui:VisualElement name="rightColumn" class="side-column" style="flex-direction: column;">
                <ui:ToggleButtonGroup label="clothing slot filters" value="0000" allow-empty-selection="true" is-multiple-selection="true" style="align-self: flex-start; -unity-font-style: bold;">
                    <ui:Button text="jackets" name="btnJacketsFilter" class="button-common filter-button"/>
                    <ui:Button text="tops" name="btnTopsFilter" class="button-common filter-button"/>
                    <ui:Button text="bottoms" name="btnBottomsFilter" class="button-common filter-button"/>
                    <ui:Button text="shoes" name="btnShoesFilter" class="button-common filter-button"/>
                </ui:ToggleButtonGroup>
                <ui:VisualElement class="textbox" style="height: 70px;">
                    <ui:Label text="Clothing Item Descriptions" name="hoverItemDesc" class="scenario-description"/>
                    <ui:Label text="Label" name="lblWarning" class="scenario-description" style="color: rgb(224, 112, 144);"/>
                </ui:VisualElement>
                <ui:ScrollView name="clothingItemsList" mode="Vertical" class="clothing-item-list"/>
                <ui:Button name="nextSceneButton" class="submit-button button-common" style="width: 325px; flex-direction: row; align-self: center; margin-top: 10px;">
                    <ui:Label text="0:00:0&#10;" name="lblTimer" class="timer-label" style="background-color: rgb(255, 255, 255); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
                    <ui:Label text="Click here to &#10;SUBMIT OUTFIT" name="lblSubmitOutfit" style="margin-left: 15px;"/>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="bottomRow" class="bottomRow">
            <ui:Image source="project://database/Assets/Art/UI/Sew%20It%20Goes%20Logo-small.png?fileID=21300000&amp;guid=118a4da3414f6e44a9f87cdf843ce0b1&amp;type=3#Sew It Goes Logo-small" name="Image" class="game-logo-small"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
