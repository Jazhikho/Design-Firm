        </ui:VisualElement>
        <ui:VisualElement name="middleRow" style="flex-grow: 1; padding-right: 50px; padding-left: 50px; margin-right: 20px; margin-left: 20px;">
            <ui:VisualElement style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Art/UI/Panels/UIPanel1.png?fileID=-2169736900652779216&amp;guid=f08f96d1ee06bf045a24fab765205359&amp;type=3#UIPanel1_0&quot;); -unity-slice-left: 500; -unity-slice-top: 500; -unity-slice-right: 500; -unity-slice-bottom: 500; padding-top: 150px; padding-right: 150px; padding-bottom: 150px; padding-left: 150px;">
                <ui:ScrollView name="CreditsScroll" style="background-image: none; padding-top: 25px; padding-right: 25px; padding-bottom: 25px; padding-left: 25px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="bottomRow" class="bottomRow">
            <ui:Image source="project://database/Assets/Art/UI/Sew%20It%20Goes%20Logo-small-shadowed.png?fileID=21300000&amp;guid=da32d1e9dd949b64ab6b973578ac13d5&amp;type=3#Sew It Goes Logo-small-shadowed" class="game-logo-small"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
