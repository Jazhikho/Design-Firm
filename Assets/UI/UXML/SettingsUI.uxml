<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/CommonStylesheet.uss?fileID=7433441132597879392&amp;guid=8e23400638b471247abded66e2e9521e&amp;type=3#CommonStylesheet"/>
    <Style src="project://database/Assets/UI/USS/SettingsStylesheet.uss?fileID=7433441132597879392&amp;guid=244f133b657301f4e8a5f109d8b337dd&amp;type=3#SettingsStylesheet"/>
    <ui:VisualElement name="AppDocumentRoot" class="app-document-root">
        <ui:Image class="background-runway full-panel-background-scale"/>
        <ui:VisualElement name="topRow" class="topRow">
            <ui:Button name="MainMenuButton" text="Back" class="button-common"/>
        </ui:VisualElement>
        <ui:VisualElement name="root">
            <ui:VisualElement name="SliderElement">
                <ui:Label text="Sound" name="labelSound"/>
                <ui:Slider label="Master" value="50" high-value="100" name="MasterSlider"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="bottomRow" class="bottomRow">
            <ui:Image source="project://database/Assets/Art/UI/Sew%20It%20Goes%20Logo-small.png?fileID=21300000&amp;guid=118a4da3414f6e44a9f87cdf843ce0b1&amp;type=3#Sew It Goes Logo-small" class="game-logo-small"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
