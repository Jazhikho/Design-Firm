<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/CommonStylesheet.uss?fileID=7433441132597879392&amp;guid=8e23400638b471247abded66e2e9521e&amp;type=3#CommonStylesheet"/>
    <Style src="project://database/Assets/UI/USS/ScenariosStylesheet.uss?fileID=7433441132597879392&amp;guid=c5e026a4e12bf4141a5ef1113f39e2cb&amp;type=3#ScenariosStylesheet"/>
    <ui:VisualElement name="AppDocumentRoot" class="app-document-root">
        <ui:Image name="imgBackground" class="background-runway"/>
        <ui:VisualElement name="topRow" class="topRow">
            <ui:Button text="Back" name="btnBack" class="button-common"/>
        </ui:VisualElement>
        <ui:VisualElement name="middleRow" style="flex-grow: 1; min-height: 0; min-width: 0;">
            <ui:Label text="Label" name="lblErrorMessage" class="status-label" style="display: none;"/>
            <ui:VisualElement name="filtersRow" style="flex-direction: row; justify-content: center;">
                <ui:VisualElement name="decadeFilters"/>
                <ui:VisualElement name="categoryFilters"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; flex-direction: row; min-height: 0; min-width: 0; visibility: visible; justify-content: center;">
                <ui:ScrollView name="scrollScenariosList" mode="Vertical" class="scenarios-list-scroll" style="-unity-slice-type: tiled; -unity-slice-left: 526; -unity-slice-top: 526; -unity-slice-right: 526; -unity-slice-bottom: 526; -unity-slice-scale: 0.6px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="bottomRow" class="bottomRow">
            <ui:Image source="project://database/Assets/Art/UI/Sew%20It%20Goes%20Logo-small.png?fileID=21300000&amp;guid=118a4da3414f6e44a9f87cdf843ce0b1&amp;type=3#Sew It Goes Logo-small" class="game-logo-small"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
