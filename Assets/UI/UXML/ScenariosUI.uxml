<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/CommonStylesheet.uss?fileID=7433441132597879392&amp;guid=8e23400638b471247abded66e2e9521e&amp;type=3#CommonStylesheet"/>
    <Style src="project://database/Assets/UI/USS/ScenariosStylesheet.uss?fileID=7433441132597879392&amp;guid=c5e026a4e12bf4141a5ef1113f39e2cb&amp;type=3#ScenariosStylesheet"/>
    <ui:VisualElement name="AppDocumentRoot" class="app-document-root">
        <ui:Image name="imgBackground" class="background-runway full-panel-background-scale"/>
        <ui:VisualElement name="topRow" style="height: 6%; margin-bottom: 0%;">
            <ui:Button text="Back" name="btnBack" class="button-common button-back"/>
        </ui:VisualElement>
        <ui:VisualElement name="middleRow" style="flex-grow: 1; min-height: 0; min-width: 0; margin-top: 4%; margin-bottom: 0%;">
            <ui:Label text="Label" name="lblErrorMessage" style="color: rgb(255, 0, 0); -unity-text-align: upper-center; -unity-font-style: bold-and-italic; display: none;"/>
            <ui:VisualElement style="flex-grow: 0; flex-direction: row; justify-content: space-around;"/>
            <ui:VisualElement name="filtersRow" style="flex-direction: row; justify-content: space-around;">
                <ui:VisualElement style="flex-grow: 0; align-self: center;">
                    <ui:VisualElement name="decadeFiltersPanel" style="flex-grow: 0; -unity-slice-type: tiled; -unity-slice-scale: 0.05px; -unity-slice-left: 353; -unity-slice-top: 353; -unity-slice-right: 353; -unity-slice-bottom: 353; background-image: url(&quot;project://database/Assets/Art/UI/Panels/UIPanel1.png?fileID=2800000&amp;guid=f08f96d1ee06bf045a24fab765205359&amp;type=3#UIPanel1&quot;); padding-left: 4%; padding-right: 4%; padding-top: 1%; padding-bottom: 1%; align-items: center; margin-bottom: 1%;">
                        <ui:Label text="Decade Filters" selectable="false" focusable="false" style="-unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Caldstone-SemiBold.otf?fileID=12800000&amp;guid=cb230a455f9d47d41b5e9547def9fba4&amp;type=3#Caldstone-SemiBold&quot;); font-size: 41px; color: rgb(255, 255, 255);"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="decadeFilters" style="flex-grow: 1;"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 0;">
                    <ui:VisualElement name="settingFiltersPanel" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Art/UI/Panels/UIPanel1.png?fileID=2800000&amp;guid=f08f96d1ee06bf045a24fab765205359&amp;type=3#UIPanel1&quot;); -unity-slice-type: tiled; padding-left: 4%; padding-right: 4%; padding-bottom: 1%; padding-top: 1%; -unity-slice-scale: 0.05px; -unity-slice-left: 353; -unity-slice-top: 353; -unity-slice-right: 353; -unity-slice-bottom: 353; align-items: center; margin-bottom: 1%;">
                        <ui:Label text="Setting Filters" style="-unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Caldstone-SemiBold.otf?fileID=12800000&amp;guid=cb230a455f9d47d41b5e9547def9fba4&amp;type=3#Caldstone-SemiBold&quot;); font-size: 41px; color: rgb(255, 255, 255); margin-left: 4px; padding-left: 2px; margin-bottom: 4px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="categoryFilters" style="flex-grow: 1;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; flex-direction: row; min-height: 0; min-width: 0; visibility: visible; justify-content: center;">
                <ui:ScrollView name="scrollScenariosList" mode="Horizontal" class="scenarios-list-scroll" style="background-image: url(&quot;project://database/Assets/Art/UI/Panels/UIPanel3.png?fileID=2800000&amp;guid=139033b5b1bc28a47aeb7effa178cc12&amp;type=3#UIPanel3&quot;); -unity-slice-type: tiled; -unity-slice-left: 197; -unity-slice-top: 197; -unity-slice-right: 197; -unity-slice-bottom: 197; -unity-slice-scale: 0.3px; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Caldstone-SemiBold.otf?fileID=12800000&amp;guid=cb230a455f9d47d41b5e9547def9fba4&amp;type=3#Caldstone-SemiBold&quot;); color: rgb(255, 255, 255); font-size: 33px; border-left-width: 0; margin-left: 5%; padding-left: 3%; padding-bottom: 7%; padding-right: 3%; padding-top: 7%; margin-right: 5%; margin-top: 1%; margin-bottom: 0%; -unity-background-image-tint-color: rgb(255, 215, 253); opacity: 0.89; flex-grow: 1;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="bottomRow" style="flex-direction: row; flex-shrink: 0; min-width: 0; margin-bottom: 1%; margin-left: 1%; margin-top: 1%;">
            <ui:Label text="Sew It Goes" name="lblGameTitle" class="game-title" style="-unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Bonello-Regular.otf?fileID=12800000&amp;guid=ccc7d1b9793303e4592d61d7db81b149&amp;type=3#Bonello-Regular&quot;); -unity-text-outline-color: rgb(249, 143, 156); -unity-text-outline-width: 1px; color: rgb(255, 200, 238); font-size: 29px; padding-top: 0; margin-top: 0; padding-right: 0; margin-right: 0; padding-bottom: 0; margin-bottom: 0; padding-left: 0; margin-left: 0; height: auto;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
