

#CreditsScroll {
    min-height: 0;
    min-width: 0;
    flex-grow: 1;
    margin-top: 4px;
    margin-bottom: 8px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/DMSans-VariableFont_opsz,wght.ttf?fileID=12800000&guid=67849e8619a53d749898b7e60ed76be0&type=3#DMSans-VariableFont_opsz,wght");
    color: rgb(255, 255, 255);
    font-size: 14px;
    padding: 6px 12px 8px 12px;
    flex-direction: column;
    align-items: stretch;
    align-self: stretch;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    background-image: url("project://database/Assets/Art/UI/Panels/UIPanel3.png?fileID=-3657673086416332405&guid=139033b5b1bc28a47aeb7effa178cc12&type=3#UIPanel3_0");
    padding-top: 50px;
    padding-bottom: 50px;
    padding-right: 50px;
    padding-left: 50px;
    background-size: 100% 100%;
}

#CreditsScroll .unity-scroller--vertical {
    width: 8px;
}

#CreditsScroll .unity-base-slider__tracker {
    background-color: rgb(42, 42, 42);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

#CreditsScroll .unity-base-slider__dragger {
    background-color: rgb(240, 128, 152);
    border-radius: 4px;
    border-width: 0;
}

#CreditsScroll .unity-scroller__high-button {
    display: none;
}

#CreditsScroll .unity-scroller__low-button,
#CreditsScroll .unity-scroller__low-button {
    display: none;
}

.credits-section-heading {
    -unity-text-align: middle-center;
    color: rgb(240, 208, 128);
    font-size: 13px;
    margin-top: 20px;
    margin-bottom: 10px;
    white-space: normal;
    -unity-text-outline-color: rgba(0, 0, 0, 0.5);
    -unity-text-outline-width: 0.3px;
    width: 100%;
    -unity-font-style: bold;
    letter-spacing: 2.5px;
}

.credits-section-heading-first {
    margin-top: 4px;
}

.credits-name-line {
    -unity-text-align: middle-center;
    color: rgb(250, 250, 252);
    font-size: 15px;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin-top: 0;
    margin-bottom: 6px;
    white-space: normal;
    align-self: stretch;
    padding-left: 4px;
    padding-right: 4px;
}

#CreditsCloseButton {
    align-self: center;
    width: 28%;
    min-width: 120px;
    max-width: 200px;
    margin-top: 4px;
    margin-bottom: 0;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/DMSans-VariableFont_opsz,wght.ttf?fileID=12800000&guid=67849e8619a53d749898b7e60ed76be0&type=3#DMSans-VariableFont_opsz,wght");
    font-size: 16px;
    flex-shrink: 0;
}
