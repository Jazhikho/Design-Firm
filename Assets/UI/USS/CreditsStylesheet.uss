#CreditsOverlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    display: none;
    background-color: rgba(0, 0, 0, 0.62);
    padding: 2%;
    flex-grow: 0;
    flex-shrink: 0;
}

#CreditsDialog {
    width: 85%;
    max-width: 900px;
    min-width: 0;
    max-height: 82%;
    min-height: 200px;
    flex-direction: column;
    flex-grow: 0;
    flex-shrink: 0;
    overflow: hidden;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 20px;
    padding-bottom: 24px;
    background-image: url("project://database/Assets/Art/UI/Panels/UIPanel3.png?fileID=2800000&guid=139033b5b1bc28a47aeb7effa178cc12&type=3#UIPanel3");
    -unity-slice-type: tiled;
    -unity-slice-left: 526;
    -unity-slice-top: 526;
    -unity-slice-right: 526;
    -unity-slice-bottom: 526;
    -unity-slice-scale: 0.5px;
}

#CreditsTitle {
    -unity-text-align: middle-center;
    color: rgb(244, 167, 188);
    font-size: 32px;
    margin-bottom: 6px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/DMSans-VariableFont_opsz,wght.ttf?fileID=12800000&guid=67849e8619a53d749898b7e60ed76be0&type=3#DMSans-VariableFont_opsz,wght");
    letter-spacing: 3px;
}

#CreditsScroll {
    min-height: 0;
    min-width: 0;
    flex-grow: 1;
    margin-top: 4px;
    margin-bottom: 8px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/DMSans-VariableFont_opsz,wght.ttf?fileID=12800000&guid=67849e8619a53d749898b7e60ed76be0&type=3#DMSans-VariableFont_opsz,wght");
    color: rgb(255, 255, 255);
    font-size: 14px;
    padding: 6px 12px 8px 12px;
    flex-direction: column;
    align-items: stretch;
    align-self: stretch;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
}

.credits-section-heading {
    -unity-text-align: middle-center;
    color: rgb(240, 208, 128);
    font-size: 13px;
    margin-top: 20px;
    margin-bottom: 10px;
    white-space: normal;
    -unity-text-outline-color: rgba(0, 0, 0, 0.5);
    -unity-text-outline-width: 0.3px;
    width: 100%;
    -unity-font-style: bold;
    letter-spacing: 2.5px;
}

.credits-section-heading-first {
    margin-top: 4px;
}

.credits-name-line {
    -unity-text-align: middle-center;
    color: rgb(250, 250, 252);
    font-size: 15px;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin-top: 0;
    margin-bottom: 6px;
    white-space: normal;
    align-self: stretch;
    padding-left: 4px;
    padding-right: 4px;
}

#CreditsCloseButton {
    align-self: center;
    width: 28%;
    min-width: 120px;
    max-width: 200px;
    margin-top: 4px;
    margin-bottom: 0;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/DMSans-VariableFont_opsz,wght.ttf?fileID=12800000&guid=67849e8619a53d749898b7e60ed76be0&type=3#DMSans-VariableFont_opsz,wght");
    font-size: 16px;
    flex-shrink: 0;
}

