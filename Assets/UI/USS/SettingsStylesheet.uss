.settings-panel {
    padding-top: 0;
    padding-bottom: 0;
    position: relative;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-left-color: rgb(240, 128, 152);
    border-right-color: rgb(240, 128, 152);
    border-top-color: rgb(240, 128, 152);
    border-bottom-color: rgb(240, 128, 152);
    border-top-left-radius: 20px;
    border-bottom-right-radius: 20px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    flex-grow: 1;
    background-color: rgb(39, 35, 35);
    padding-right: 20%;
    padding-left: 20%;
}

.settings-header {
    color: rgb(245, 240, 232);
    -unity-font-style: bold;
    font-size: 32px;
    -unity-text-align: upper-center;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/DMSans-VariableFont_opsz,wght.ttf?fileID=12800000&guid=67849e8619a53d749898b7e60ed76be0&type=3#DMSans-VariableFont_opsz,wght");
}

.middle-row {
    flex-grow: 1;
}

.slider {
    font-size: 18px;
    color: rgb(245, 240, 232);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/DMSans-VariableFont_opsz,wght.ttf?fileID=12800000&guid=67849e8619a53d749898b7e60ed76be0&type=3#DMSans-VariableFont_opsz,wght");
    min-height: auto;
}

.slider .unity-base-slider__tracker {
    background-color: rgb(224, 112, 144);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    height: 15px;
}

.slider .unity-base-slider__dragger {
    background-color: rgb(39, 35, 35);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    width: 25px;
    height: 35px;
    border-left-color: rgb(240, 128, 152);
    border-right-color: rgb(240, 128, 152);
    border-top-color: rgb(240, 128, 152);
    border-bottom-color: rgb(240, 128, 152);
}
