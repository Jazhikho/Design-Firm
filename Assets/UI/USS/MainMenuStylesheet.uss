.main-menu-root {
    width: 100%;
    height: 100%;
    min-height: 0;
    flex-grow: 1;
    flex-direction: column;
    flex-shrink: 0;
}

.main-menu-scroll {
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
    max-width: 100%;
    width: 100%;
    height: 100%;
    flex-shrink: 1;
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/DMSans-VariableFont_opsz,wght.ttf?fileID=12800000&guid=67849e8619a53d749898b7e60ed76be0&type=3#DMSans-VariableFont_opsz,wght");
    padding-top: 0%;
    padding-right: 0%;
    padding-bottom: 0%;
    padding-left: 0%;
}

.main-menu-content-wrap {
    width: 100%;
    min-height: 100%;
    flex-direction: column;
    justify-content: space-evenly;
    align-items: center;
    margin-top: 0;
    margin-bottom: 0;
    flex-grow: 0;
    flex-shrink: 0;
    padding-top: 0%;
    padding-right: 0%;
    padding-bottom: 0%;
    padding-left: 0%;
}

Button.main-menu-button {
    position: relative;
    overflow: visible;
    align-self: center;
    width: 425px;
    height: 48px;
    flex-shrink: 0;
    margin-top: 10px;
    margin-bottom: 10px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/DMSans-VariableFont_opsz,wght.ttf?fileID=12800000&guid=67849e8619a53d749898b7e60ed76be0&type=3#DMSans-VariableFont_opsz,wght");
    font-size: 15px;
}

.main-menu-sandbox-flyout {
    flex-direction: row;
    align-self: center;
}

.sandbox-option-button {
    width: 200px;
    height: 40px;
}

.logo-image {
    width: 50%;
    height: 50%;
    align-self: center;
    margin-top: 75px;
}

.tutorial-text {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/DMSans-VariableFont_opsz,wght.ttf?fileID=12800000&guid=67849e8619a53d749898b7e60ed76be0&type=3#DMSans-VariableFont_opsz,wght");
    -unity-font-style: bold;
    color: rgb(253, 195, 211);
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    -unity-text-align: middle-center;
    white-space: normal;
    align-self: center;
    height: 48px;
    width: 425px;
}
