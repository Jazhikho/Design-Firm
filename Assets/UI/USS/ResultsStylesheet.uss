#middleRow {
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
}



#colYourOutfitVisual {
    min-height: 0;
    max-height: 100%;
}

.clothing-score-tile {
    height: 100px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    background-color: rgb(255, 255, 255);
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    width: 75px;
}

.label-avatar {
    color: rgb(250, 212, 224);
    -unity-text-align: upper-center;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/PlayfairDisplay-Italic-VariableFont_wght.ttf?fileID=12800000&guid=f3e8544bd95ce5b48a88e430d527318e&type=3#PlayfairDisplay-Italic-VariableFont_wght");
    -unity-text-outline-width: 0.5px;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-font-style: bold;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    font-size: 24px;
}

.outfitContainer {
    background-color: rgba(245, 240, 232, 0.7);
    margin-top: 10px;
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    padding: 8px;
}

.item-score {
    -unity-font-style: italic;
    -unity-text-align: upper-right;
    font-size: 10px;
    margin-top: 0;
    margin-bottom: 0;
    flex-shrink: 0;
    min-width: 30px;
    color: rgb(26, 26, 42);
}

.item-hint {
    -unity-font-style: italic;
    margin-top: 0;
    margin-bottom: 0;
    white-space: normal;
    -unity-text-align: upper-right;
    font-size: 10px;
    color: rgb(26, 26, 42);
}

.item-feedback {
    -unity-font-style: italic;
    font-size: 10px;
    white-space: normal;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 8px;
    flex-grow: 1;
    flex-shrink: 1;
    color: rgb(26, 26, 42);
}

.total-score {
    -unity-text-align: upper-right;
}

.outfit-h1 {
    -unity-font-style: bold;
    color: rgb(244, 167, 188);
}

.feedbackContainer {
    margin-bottom: 10px;
    flex-direction: row;
}

.hintContainer {
    margin-bottom: 10px;
}

.middle-column {
    flex-basis: 0;
    min-width: 200px;
    position: relative;
    flex-grow: 2;
}

.stacked-image {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.results-button {
    width: 125px;
}
