#middleRow {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.wardrobe-room-background {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Art/Backgrounds/dressingRoom2.jpg?fileID=696369056450087122&guid=f9dca0261f58d0643a74c46db966cf56&type=3#dressingRoom2_0");
}

.clothing-item-list {
    flex-direction: row;
}

.submit-button {
    background-color: rgb(250, 212, 224);
    color: rgb(42, 16, 32);
    border-left-color: rgb(224, 112, 144);
    border-right-color: rgb(224, 112, 144);
    border-top-color: rgb(224, 112, 144);
    border-bottom-color: rgb(224, 112, 144);
    border-left-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-top-width: 3px;
    width: 125px;
    height: 75px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/DMSans-VariableFont_opsz,wght.ttf?fileID=12800000&guid=67849e8619a53d749898b7e60ed76be0&type=3#DMSans-VariableFont_opsz,wght");
    font-size: 16px;
}

.submit-button:hover {
    background-color: rgb(250, 185, 200);
}

.side-column {
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
    margin-left: 4px;
    margin-right: 4px;
    margin-top: 4px;
    margin-bottom: 4px;
    flex-direction: row;
    flex-grow: 2;
}

.middle-column {
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
    position: relative;
    flex-grow: 2;
}

.filter-button {
    margin: 4px;
    padding: 6px 12px;
    background-color: rgb(42, 42, 42);
    color: rgb(192, 176, 176);
    border-left-color: rgb(64, 64, 64);
    border-right-color: rgb(64, 64, 64);
    border-top-color: rgb(64, 64, 64);
    border-bottom-color: rgb(64, 64, 64);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

.filter-button:checked {
    background-color: rgb(240, 128, 152);
    color: rgb(42, 26, 32);
    border-left-color: rgb(240, 128, 152);
    border-right-color: rgb(240, 128, 152);
    border-top-color: rgb(240, 128, 152);
    border-bottom-color: rgb(240, 128, 152);
}

.wardrobe-tile {
    width: 200px;
    height: 200px;
    margin: 6px;
    padding: 3px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.25);
    border-right-color: rgba(255, 255, 255, 0.25);
    border-top-color: rgba(255, 255, 255, 0.25);
    border-bottom-color: rgba(255, 255, 255, 0.25);
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.wardrobe-tile.selected {
    border-left-color: rgb(224, 112, 144);
    border-right-color: rgb(224, 112, 144);
    border-top-color: rgb(224, 112, 144);
    border-bottom-color: rgb(224, 112, 144);
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-bottom-width: 5px;
}

.wardrobe-tile-image {
    position: absolute;
    -unity-background-scale-mode: scale-to-fit;
}

.wardrobe-tile-image--jacket {
    width: 275%;
    height: 275%;
    left: -150px;
    top: -75px;
}

.wardrobe-tile-image--top {
    width: 275%;
    height: 275%;
    left: -150px;
    top: -50%;
}

.wardrobe-tile-image--bottom {
    width: 175%;
    height: 175%;
    left: -75px;
    top: -125px;
}

.wardrobe-tile-image--shoes {
    width: 275%;
    height: 275%;
    left: -175px;
    top: -375px;
}

.wardrobe-tile.missing-art {
    border-left-color: rgb(140, 140, 140);
    border-right-color: rgb(140, 140, 140);
    border-top-color: rgb(140, 140, 140);
    border-bottom-color: rgb(140, 140, 140);
    opacity: 0.5;
}

.wardrobe-tile-placeholder {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.stacked-image {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.scenario-description {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/DMSans-VariableFont_opsz,wght.ttf?fileID=12800000&guid=67849e8619a53d749898b7e60ed76be0&type=3#DMSans-VariableFont_opsz,wght");
    -unity-text-align: middle-center;
    align-self: center;
    align-items: center;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    margin-top: 0;
    margin-right: 10px;
    margin-bottom: 0;
    margin-left: 10px;
    font-size: 14px;
    color: rgb(250, 212, 224);
    -unity-font-style: bold;
    text-overflow: ellipsis;
}

.timer-label {
    font-size: 32px;
    -unity-text-align: middle-center;
    color: rgb(0, 0, 0);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/SpaceMono-Bold.ttf?fileID=12800000&guid=0f3697b95b9eac24aa5f0f21871cf207&type=3#SpaceMono-Bold");
}

.timer-label.timer-warning {
    color: rgb(219, 49, 49);
}

.clothing-info-panel {
    background-color: rgba(255, 239, 213, 0);
    background-image: url("project://database/Assets/Art/UI/Panels/UIPanel1.png?fileID=2800000&guid=f08f96d1ee06bf045a24fab765205359&type=3#UIPanel1");
    -unity-slice-left: 334;
    -unity-slice-top: 334;
    -unity-slice-right: 334;
    -unity-slice-bottom: 334;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.07px;
    align-items: flex-start;
    justify-content: flex-start;
    align-content: flex-start;
}

.clothing-info-label {
    font-size: 20%;
    width: 100px;
    height: 100px;
    white-space: pre-wrap;
    align-self: center;
    -unity-text-align: middle-center;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 20px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/DMSans-VariableFont_opsz,wght.ttf?fileID=12800000&guid=67849e8619a53d749898b7e60ed76be0&type=3#DMSans-VariableFont_opsz,wght");
}

.clothing-item-list .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.clothing-item-list .unity-scroller--vertical {
    width: 8px;
}

.clothing-item-list .unity-base-slider__tracker {
    background-color: rgb(42, 42, 42);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.clothing-item-list .unity-base-slider__dragger {
    background-color: rgb(240, 128, 152);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.clothing-item-list .unity-scroller__high-button {
    display: none;
}

.clothing-item-list .unity-scroller__low-button {
    display: none;
}

.textbox {
    background-color: rgb(39, 35, 35);
    border-left-color: rgb(240, 128, 152);
    border-right-color: rgb(240, 128, 152);
    border-top-color: rgb(240, 128, 152);
    border-bottom-color: rgb(240, 128, 152);
    border-top-left-radius: 20px;
    border-bottom-right-radius: 20px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
}
