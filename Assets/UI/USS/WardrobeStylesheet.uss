.wardrobe-room-background {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.root {
    flex-direction: column;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    position: relative;
}

#topRow {
    flex-shrink: 0;
    min-width: 0;
}

#bottomRow {
    flex-shrink: 0;
    min-width: 0;
    width: 100%;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
}

#middleRow {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.side-column {
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
    margin-left: 4px;
    margin-right: 4px;
    margin-top: 9%;
    margin-bottom: 4px;
    flex-direction: row;
    flex-grow: 2;
}

.middle-column {
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
    position: relative;
    flex-grow: 2;
}

.half-list {
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
    max-width: 100%;
}

.wardrobe-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    padding: 4px;
    justify-content: center;
    margin-top: 0%;
}

.wardrobe-tile {
    width: 150px;
    height: 150px;
    margin: 4px;
    padding: 3px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.5);
    border-right-color: rgba(255, 255, 255, 0.5);
    border-top-color: rgba(255, 255, 255, 0.5);
    border-bottom-color: rgba(255, 255, 255, 0.5);
    justify-content: center;
    align-items: flex-end;
    overflow: hidden;
}

.wardrobe-tile.selected {
    border-left-color: rgb(255, 200, 238);
    border-right-color: rgb(255, 200, 238);
    border-top-color: rgb(255, 200, 238);
    border-bottom-color: rgb(255, 200, 238);
    border-left-width: 10px;
    border-right-width: 10px;
    border-top-width: 10px;
    border-bottom-width: 10px;
    background-color: rgb(255, 243, 186);
}

.wardrobe-tile-image {
    position: absolute;
    -unity-background-scale-mode: scale-to-fit;
}

#jacketsGrid .wardrobe-tile-image {
    width: 300%;
    height: 300%;
    left: -90%;
    top: -30%;
}

#topsGrid .wardrobe-tile-image {
    width: 300%;
    height: 300%;
    left: -95%;
    top: -70%;
}

#bottomsGrid .wardrobe-tile-image {
    width: 300%;
    height: 300%;
    left: -90%;
    top: -115%;
}

#shoesGrid .wardrobe-tile-image {
    width: 330%;
    height: 330%;
    left: -120%;
    top: -250%;
}

.wardrobe-tile.missing-art {
    border-left-color: rgb(140, 140, 140);
    border-right-color: rgb(140, 140, 140);
    border-top-color: rgb(140, 140, 140);
    border-bottom-color: rgb(140, 140, 140);
    opacity: 0.5;
}

.wardrobe-tile-placeholder {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.image-stack {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    position: relative;
}

.stacked-image {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.btnRack {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    top: 0;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(188, 188, 188, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.clothingContainers {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
}

.scenario-description {
    background-color: rgb(255, 235, 205);
}

.btnJacketsRack {
    background-image: url("project://database/Assets/Art/UI/Clickables/jacketsTrunkPlain.png?fileID=-5325348902955536105&guid=207e6fddde04e8241a342041ff9184cc&type=3#Trunk (Jackets)_0");
}

.btnJacketsRack:hover {
    background-image: url("project://database/Assets/Art/UI/Clickables/jacketsTrunkOutline.png?fileID=4100172068830262562&guid=25ff79fd7cae1f44d8c734861c765dfc&type=3#Trunk (Jackets, Selected)_0");
}

.btnTopsRack {
    background-image: url("project://database/Assets/Art/UI/Clickables/shirtsTrunkPlain.png?fileID=-7412495946125636110&guid=3320c62a4b34d504eae5d513dfb1944b&type=3#Trunk (Shirts)_0");
}

.btnTopsRack:hover {
    background-image: url("project://database/Assets/Art/UI/Clickables/shirtsTrunkOutline.png?fileID=-9133157273055805236&guid=46cfb5a7f7cf70b47a129bb1f03e9ada&type=3#Trunk (Shirts, Selected)_0");
}

.btnBottomsRack {
    background-image: url("project://database/Assets/Art/UI/Clickables/pantsTrunkPlain.png?fileID=-8522457506933049410&guid=351a57606a353cb49b7567b5b949eb9d&type=3#Trunk (Pants)_0");
}

.btnBottomsRack:hover {
    background-image: url("project://database/Assets/Art/UI/Clickables/pantsTrunkOutline.png?fileID=-3626505164924125620&guid=53f0a03963037e0468a570e2ac2ac6d5&type=3#Trunk (Pants, Selected)_0");
}

.shoeRack {
    background-image: url("project://database/Assets/Art/UI/Clickables/shoeRackPlain.png?fileID=2800000&guid=309ab8a8051763e47b7ca0e47df3d8f0&type=3#shoeRackPlain");
    background-size: cover;
}

.shoeRack:hover {
    background-image: url("project://database/Assets/Art/UI/Clickables/shoeRackOutline.png?fileID=2800000&guid=21428c23e6c2c0f47b547580bf605755&type=3#shoeRackOutline");
    background-size: cover;
}
