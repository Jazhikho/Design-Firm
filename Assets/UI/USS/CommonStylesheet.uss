.app-document-root {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
    flex-shrink: 0;
    flex-direction: column;
    position: relative;
}

.full-panel-background-scale {
    -unity-background-scale-mode: scale-to-fit;
}

.background-runway {
    position: absolute;
    background-image: url("project://database/Assets/Art/Backgrounds/RunwayBlockout.jpg?fileID=21300000&guid=f18ea575f83278347a4688f400d99869&type=3#RunwayBlockout");
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.game-title {
    align-items: center;
    align-self: flex-start;
    height: 26px;
    width: 144px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(253, 136, 202);
    font-size: 18px;
    -unity-font-style: bold-and-italic;
}

.button-common {
    height: 32px;
    width: 100px;
    background-color: rgb(255, 200, 238);
    border-left-color: rgb(249, 143, 156);
    border-right-color: rgb(249, 143, 156);
    border-top-color: rgb(249, 143, 156);
    border-bottom-color: rgb(249, 143, 156);
    border-left-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-top-width: 3px;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    transition-property: all;
    transition-duration: 0s;
    transition-timing-function: ease;
    transition-delay: 0s;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Caldstone-SemiBold.otf?fileID=12800000&guid=cb230a455f9d47d41b5e9547def9fba4&type=3#Caldstone-SemiBold");
    color: rgb(0, 0, 0);
    -unity-font-style: normal;
    -unity-slice-left: 340;
    -unity-slice-top: 340;
    -unity-slice-right: 340;
    -unity-slice-bottom: 340;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.1px;
}

.button-common:hover {
    background-color: rgb(255, 243, 186);
}

.button-common:active {
    background-color: rgb(249, 143, 156);
}

.button-back {
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Caldstone-SemiBold.otf?fileID=12800000&guid=cb230a455f9d47d41b5e9547def9fba4&type=3#Caldstone-SemiBold");
    margin-left: 1%;
    margin-top: 1%;
    font-size: 25px;
    width: 6%;
    height: 64%;
}

.main-menu-btn {
    width: 188px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Caldstone-SemiBold.otf?fileID=12800000&guid=cb230a455f9d47d41b5e9547def9fba4&type=3#Caldstone-SemiBold");
    margin-top: 0%;
    margin-bottom: 1%;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
    margin-right: 4px;
    margin-left: 4px;
    height: auto;
    background-color: rgb(255, 200, 238);
    border-left-color: rgb(249, 143, 156);
    border-right-color: rgb(249, 143, 156);
    border-top-color: rgb(249, 143, 156);
    border-bottom-color: rgb(249, 143, 156);
    border-left-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-top-width: 3px;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    transition-property: all;
    transition-duration: 0s;
    transition-timing-function: ease;
    transition-delay: 0s;
    font-size: 38px;
}

.main-menu-btn:hover {
    background-color: rgb(255, 243, 186);
}

.main-menu-btn:active {
    background-color: rgb(249, 143, 156);
}



#scrollScenariosList #unity-tracker {
    background-image: url("project://database/Assets/Art/UI/Sliders/Slider_Sew.png?fileID=2800000&guid=70febfc68954cbe449e4bf0a19e96323&type=3#Slider_Sew");
    -unity-slice-type: tiled;
    -unity-slice-left: 300;
    -unity-slice-top: 300;
    -unity-slice-right: 300;
    -unity-slice-bottom: 300;
    -unity-slice-scale: 0.1px;
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

#scrollScenariosList #unity-dragger {
    background-color: rgba(255, 255, 255, 0);
    background-image: url("project://database/Assets/Art/UI/Sliders/Dragger_Sew.png?fileID=2800000&guid=f6e9df0b2c7b7db4da7f8ef8dd9e0574&type=3#Dragger_Sew");
    width: 34px;
    -unity-slice-type: tiled;
    -unity-slice-left: 212;
    -unity-slice-top: 212;
    -unity-slice-right: 212;
    -unity-slice-bottom: 212;
    -unity-slice-scale: 0.1px;
}

#scrollScenariosList #unity-dragger-border {
}

#scrollScenariosList #unity-low-button {
    visibility: hidden;
}

#scrollScenariosList #unity-high-button {
    visibility: hidden;
}


