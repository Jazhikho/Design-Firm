.topRow {
    flex-shrink: 0;
    min-width: 0;
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
    flex-direction: row;
}

.bottomRow {
    align-items: flex-start;
    flex-direction: row;
    padding-right: 20px;
    padding-left: 20px;
    padding-bottom: 20px;
    flex-shrink: 0;
}

.app-document-root {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
    flex-shrink: 0;
    flex-direction: column;
    position: relative;
}

.background-runway {
    position: absolute;
    background-image: url("project://database/Assets/Art/Backgrounds/RunwayBlockout.jpg?fileID=21300000&guid=f18ea575f83278347a4688f400d99869&type=3#RunwayBlockout");
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.button-common {
    height: 32px;
    width: 100px;
    background-color: rgb(240, 128, 152);
    color: rgb(42, 26, 32);
    border-left-color: rgba(255, 255, 255, 0.2);
    border-right-color: rgba(255, 255, 255, 0.2);
    border-top-color: rgba(255, 255, 255, 0.2);
    border-bottom-color: rgba(255, 255, 255, 0.2);
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-top-width: 2px;
    transition-property: all;
    transition-duration: 0s;
    transition-timing-function: ease;
    transition-delay: 0s;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/DMSans-VariableFont_opsz,wght.ttf?fileID=12800000&guid=67849e8619a53d749898b7e60ed76be0&type=3#DMSans-VariableFont_opsz,wght");
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    -unity-font-style: bold;
    transition-property: scale, background-color;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
    transition-delay: 0s;
}

.button-common:hover {
    background-color: rgb(224, 112, 144);
}

.small-game-title {
    height: 72px;
    aspect-ratio: 3.5;
    flex-shrink: 0;
    flex-grow: 0;
    align-self: center;
}

.game-logo-small {
    width: 190px;
}

.textbox {
    background-color: rgb(39, 35, 35);
    border-left-color: rgb(240, 128, 152);
    border-right-color: rgb(240, 128, 152);
    border-top-color: rgb(240, 128, 152);
    border-bottom-color: rgb(240, 128, 152);
    border-top-left-radius: 20px;
    border-bottom-right-radius: 20px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
}

.main-menu-button {
}









.stacked-image-ideal-outfit {
    width: 65%;
}
