#topRow {
    flex-shrink: 0;
    min-width: 0;
}

#middleRow {
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
    flex-direction: column;
}

#bottomRow {
    flex-shrink: 0;
    min-width: 0;
}

#filtersRow {
    flex-shrink: 0;
    min-width: 0;
    flex-wrap: wrap;
}

.status-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 38%;
    bottom: auto;
    -unity-text-align: middle-center;
    white-space: normal;
}

.scenarios-list-scroll {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    max-width: 100%;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 20px;
    padding-bottom: 20px;
}

.filter-toggle-group {
    flex-direction: row;
    justify-content: center;
    align-self: center;
}

.filter-button {
    margin: 4px;
    padding: 6px 12px;       
    font-size: 30px;
    background-color: rgb(255, 200, 238);
    border-left-color: rgb(249, 143, 156);
    border-right-color: rgb(249, 143, 156);
    border-top-color: rgb(249, 143, 156);
    border-bottom-color: rgb(249, 143, 156);
    border-left-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-top-width: 3px;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    transition-property: all;
    transition-duration: 0s;
    transition-timing-function: ease;
    transition-delay: 0s;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Caldstone-SemiBold.otf?fileID=12800000&guid=cb230a455f9d47d41b5e9547def9fba4&type=3#Caldstone-SemiBold");
    color: rgb(0, 0, 0);
}

.filter-button:hover {
    background-color: rgb(255, 243, 186);
}

.filter-button:active {
    background-color: rgb(249, 143, 156);
}

.scenario-card {
    width: 400px;
    min-height: 200px;
    margin: 18px;
    padding: 25px;
    flex-shrink: 0;
    align-items: center;
    background-image: url("project://database/Assets/Art/UI/Panels/UIPanel2.png?fileID=2800000&guid=6925f7cb30e0e2f4bb907aa6ffd266eb&type=3#UIPanel2");
    -unity-slice-left: 340;
    -unity-slice-top: 340;
    -unity-slice-right: 340;
    -unity-slice-bottom: 340;
    -unity-slice-type: tiled;
    -unity-slice-scale: 0.1px;
}

.scenario-card-name {
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    white-space: normal;
    margin-bottom: 8px;
}

.scenario-card-description {
    white-space: normal;
    -unity-font-style: italic;
    -unity-text-align: upper-center;
    flex-grow: 1;
    margin-bottom: 8px;
}

.scenario-card-select {
    align-self: center;
    padding: 6px 16px;
    background-color: rgb(255, 200, 238);
    border-left-color: rgb(249, 143, 156);
    border-right-color: rgb(249, 143, 156);
    border-top-color: rgb(249, 143, 156);
    border-bottom-color: rgb(249, 143, 156);
    border-left-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-top-width: 3px;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    transition-property: all;
    transition-duration: 0s;
    transition-timing-function: ease;
    transition-delay: 0s;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Caldstone-SemiBold.otf?fileID=12800000&guid=cb230a455f9d47d41b5e9547def9fba4&type=3#Caldstone-SemiBold");
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
}

.scenario-card-select:hover {
    background-color: rgb(255, 243, 186);
}

.scenario-card-select:active {
    background-color: rgb(249, 143, 156);
}
