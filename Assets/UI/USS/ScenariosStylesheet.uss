#middleRow {
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
    flex-direction: column;
}

#filtersRow {
    flex-shrink: 0;
    min-width: 0;
    flex-wrap: wrap;
}

.status-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 38%;
    bottom: auto;
    -unity-text-align: middle-center;
    white-space: normal;
}

.scenarios-list-scroll {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    max-width: 100%;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 20px;
    padding-bottom: 20px;
    margin-left: 25px;
    margin-right: 25px;
}

#scrollScenariosList .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.filter-toggle-group {
    flex-direction: row;
    justify-content: center;
    align-self: center;
}

.filter-button {
    margin: 4px;
    padding: 6px 12px;
    background-color: rgba(42,42,42,1);
    color: rgba(192,176,176,1);
    border-color: rgba(64,64,64,1);
    border-width: 1px;
}

.filter-button:hover {
    background-color: rgba(61,56,56,1);
    color: rgba(245,240,232,1);
    border-color: rgba(192,144,168,1);
    translate: 0 -1px;
}

.filter-button:checked {
    background-color: rgba(240,128,152,1);
    color: rgba(42,26,32,1);
    border-color: rgba(224,112,144,1);
}

.status-label-error {
    color: rgb(224, 80, 80);
    -unity-font-style: bold-and-italic;
}

.scenario-card {
    width: 255px;
    min-height: 250px;
    margin: 8px;
    padding: 12px;
    border-width: 2px;
    border-color: rgb(240, 128, 152);
    border-radius: 6px;
    flex-shrink: 0;
    align-items: center;
    background-color: rgb(30, 30, 30);
    height: 175px;
}

.scenario-card:hover {
    border-width: 3px;
    border-color: rgb(240, 128, 152);
}

.scenario-card-name {
    font-size: 18px;
    -unity-font-style: bold-and-italic;
    -unity-text-align: upper-center;
    white-space: normal;
    margin-bottom: 8px;
    color: rgb(240, 128, 152);
}

.scenario-card-description {
    white-space: normal;
    -unity-font-style: italic;
    -unity-text-align: upper-center;
    flex-grow: 1;
    margin-bottom: 8px;
    color: rgb(224, 216, 208);
}

.scenario-card-select {
    align-self: flex-end;
    padding: 6px 16px;
    background-color: rgb(56, 56, 56);
    color: rgb(160, 144, 144);
    border-left-color: rgb(72, 72, 72);
    border-right-color: rgb(72, 72, 72);
    border-top-color: rgb(72, 72, 72);
    border-bottom-color: rgb(72, 72, 72);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

#scrollScenariosList .unity-scroller--vertical {
    width: 8px;
}

#scrollScenariosList .unity-base-slider__tracker {
    background-color: rgb(42, 42, 42);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

#scrollScenariosList .unity-base-slider__dragger {
    background-color: rgb(240, 128, 152);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

#scrollScenariosList .unity-scroller__high-button {
    display: none;
}

#scrollScenariosList .unity-scroller__low-button,
#scrollScenariosList .unity-scroller__low-button {
    display: none;
}
